# 이 저장소는 뉴스레터/SNS 자동화 코드(scripts/, tests/, docs/)만 버전관리합니다.
# 업무 자료 폴더(001~999 등), 개인 문서, 대용량 바이너리, 비밀값은 의도적으로 제외합니다.

# --- 비밀값 / 자격증명 ---
scripts/.env
# .claude 는 스킬만 추적하고 나머지(자격증명 링크, 캐시, 로컬설정)는 제외
.claude/*
!.claude/skills/
*.url

# --- 런타임 상태 / 캐시 ---
scripts/state/*.json
!scripts/state/.gitkeep
scripts/lib/__pycache__/
tests/__pycache__/
**/__pycache__/
.pytest_cache/
*.pyc

# --- Windows / 잡파일 ---
desktop.ini
Thumbs.db

# --- 업무 자료 폴더 (대용량, 비코드) ---
/001. 뉴스레터/
/002. SNS/
/004. 글무 26/
/005. 인수인계/
/900. 긴급/
/999. 기타/
/_claude-memory/

# --- 개인/업무 문서 (레포 루트 잡파일) ---
/*.html
/*.png
/*.docx
/*.md
!/CLAUDE.md
/pdf_extract*.txt

# 인수인계 폴더 배포용 압축본 (폴더 내용과 중복, 공유용 임시 산출물)
/뉴스레터 HTML.zip
# 인수인계 폴더 안에 실수/의도로 들어간 실제 업무 테스트 자료 (대용량, 비코드)
/뉴스레터 HTML/코드/.claude/skills/테스트 파일/
